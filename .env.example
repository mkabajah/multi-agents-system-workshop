# Copy this file to .env and pick ONE model.

# 1) No key, no network: a scripted fake model. Shows the mechanics (who calls whom), not real answers.
MODEL=fake

# 2) A real model (uncomment one and set its key)
# MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=sk-...
# MODEL=anthropic:claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
# Free and fast: Groq, through the OpenAI-compatible API
# MODEL=openai:openai/gpt-oss-20b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# Local and free: Ollama (pip install langchain-ollama; ollama pull qwen2.5:7b)
# MODEL=ollama:qwen2.5:7b
